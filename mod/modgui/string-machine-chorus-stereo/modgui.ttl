@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

# MOD web GUI for string-machine-chorus-stereo.
# Paths are relative to the .lv2 bundle root; the web resources live in
# modgui/. The stylesheet is assembled at build time from
# mod/modgui/common/skin.css + mod/modgui/string-machine-chorus-stereo/modgui/stylesheet-string-machine-chorus-stereo.css.
# The "Enabled" port (lv2:designation lv2:enabled) is the MOD bypass.

<http://jpcima.sdf1.org/lv2/string-machine-chorus-stereo>
    modgui:gui [
        a modgui:Gui ;
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-string-machine-chorus-stereo.html> ;
        modgui:stylesheet <modgui/stylesheet-string-machine-chorus-stereo.css> ;
        modgui:screenshot <modgui/screenshot-string-machine-chorus-stereo.png> ;
        modgui:thumbnail <modgui/thumbnail-string-machine-chorus-stereo.png> ;
        modgui:brand "jpcima" ;
        modgui:label "SM Chorus St" ;

        modgui:port [
            lv2:index 4 ; lv2:symbol "cho_depth" ; lv2:name "Chorus global depth" ;
        ] , [
            lv2:index 5 ; lv2:symbol "cho_rate1" ; lv2:name "Chorus rate 1" ;
        ] , [
            lv2:index 6 ; lv2:symbol "cho_depth1" ; lv2:name "Chorus depth 1" ;
        ] , [
            lv2:index 7 ; lv2:symbol "cho_rate2" ; lv2:name "Chorus rate 2" ;
        ] , [
            lv2:index 8 ; lv2:symbol "cho_depth2" ; lv2:name "Chorus depth 2" ;
        ] , [
            lv2:index 9 ; lv2:symbol "cho_model" ; lv2:name "Chorus model" ;
        ] , [
            lv2:index 10 ; lv2:symbol "wet_gain" ; lv2:name "Wet gain" ;
        ] , [
            lv2:index 11 ; lv2:symbol "dry_gain" ; lv2:name "Dry gain" ;
        ] ;
    ] .
